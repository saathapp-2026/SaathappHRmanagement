generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  email        String   @unique
  passwordHash String?
  name         String
  status       String   @default("Invited") // Invited, Pending Profile, Active, Suspended
  role         String   @default("Employee") // Employee, Admin, HR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auth tokens
  invitationToken   String?   @unique
  invitationExpires DateTime?
  resetToken        String?   @unique
  resetExpires      DateTime?

  // Profile Information
  mobileNumber             String?
  dateOfBirth              DateTime?
  address                  String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  // Employment Information
  department       String?
  designation      String?
  reportingManager String?
  joiningDate      DateTime?
  employmentType   String?
  workLocation     String?

  sessions      Session[]
  attendance    Attendance[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  concerns      Concern[]
  helpRequests  HelpRequest[]
  documents     Document[]
  notifications Notification[]
}

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String
  date         DateTime  @default(now()) // Stored as a date (e.g. start of day UTC)
  checkIn      DateTime
  checkOut     DateTime?
  status       String // Present, Late, Half Day, Absent
  workingHours Float? // Total working hours

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
}

model AttendanceCorrection {
  id           String    @id @default(uuid())
  attendanceId String
  reason       String
  requestedIn  DateTime?
  requestedOut DateTime?
  status       String    @default("Pending") // Pending, Approved, Rejected
  createdAt    DateTime  @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
}

model LeaveBalance {
  id         String @id @default(uuid())
  employeeId String
  leaveType  String // Casual, Sick, Earned
  total      Int
  used       Int    @default(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType])
}

model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("Pending") // Pending, Approved, Rejected, Cancelled
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Concern {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  employeeId  String
  subject     String
  description String
  isAnonymous Boolean  @default(false)
  status      String   @default("Open") // Open, In Progress, Resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model HelpRequest {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  employeeId  String
  category    String
  subject     String
  description String
  status      String   @default("Open") // Open, Assigned, In Progress, Resolved, Closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Document {
  id         String   @id @default(uuid())
  employeeId String
  name       String
  category   String // Onboarding, Payroll, Policies
  url        String   @default("#")
  size       String
  type       String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  type        String
  description String
  publishedAt DateTime @default(now())
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  type        String // Holiday, Event, Meeting
  description String?
}

model Notification {
  id         String   @id @default(uuid())
  employeeId String
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  employeeId   String
  expires      DateTime
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
