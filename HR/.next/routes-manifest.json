  "dynamicRoutes": [
    {
      "page": "/help/[id]",
      "regex": "^/help/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/help/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
